# --- Graphify ---
# Önbellek ve makineye özel / geçici yan dosyalar (yeniden üretilebilir)
graphify-out/cache/
graphify-out/.graphify_*
!graphify-out/.graphify_labels.json
graphify-out/.needs_update
# graphify update'in tarihli yedek klasörleri (ör. graphify-out/2026-10-19/): önceki grafiğin
# yeniden üretilebilir kopyası; aktif kaynak graphify-out/graph.json'dır ve geçmişi git'tedir.
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
graphify-out/.graphify_labels.json.sig
graphify-out/.graphify_labels.pending.json
# Yeniden üretilebilir görselleştirme ve opsiyonel dışa aktarımlar
graphify-out/graph.html
graphify-out/obsidian/
graphify-out/wiki/
graphify-out/cypher.txt
graphify-out/graph.svg
graphify-out/graph.graphml
# Not: graph.json, GRAPH_REPORT.md ve manifest Claude/ekip için depoda tutulur.

# --- Claude Code ---
# Kişisel yerel ayarlar ve Graphify'ın ayar yedekleri
.claude/settings.local.json
.claude/*.bak

# --- Genel ---
.env
.env.*
__pycache__/
.pytest_cache/
*.py[cod]
.venv/
venv/
node_modules/
.DS_Store
Thumbs.db

# --- SafeRoute veri ---
# Ham, ara ve işlenmiş veri büyüktür ve belgelenmiş komutlarla yeniden üretilebilir.
# data/metadata/ altındaki küçük edinim/kaynak kayıtları (JSON) git'te İZLENİR.
/data/raw/*
/data/interim/*
/data/processed/*
!/data/**/.gitkeep

# --- Derleme ve geçici dosyalar ---
build/
dist/
*.egg-info/
.ipynb_checkpoints/
*.partial
*.tmp
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Faz 4: 3D varlıklar ---
# İndirilen kaynak paketler (ZIP) büyük ve üçüncü taraf dağıtımıdır; depoya eklenmez.
# Kaynak, SHA-256 ve lisans bilgisi frontend/public/models/registry.json içinde kayıtlıdır.
/assets/3d/downloads/

# --- Faz 6 çalışma zamanı (başlatma betiği PID/günlük) ---
.saferoute/
